generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @unique
  email       String   @unique
  password    String
  displayName String
  role        Role     @default(Player)
  managerId   String?  @unique
  games       Game[]
  manager     Manager?
  player      Player?
}

model Manager {
  id          String @id @unique
  displayName String
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id])
  teams       Team[]
}

model Team {
  id          String        @id @unique
  name        String
  managerId   String
  players     Player[]
  PlayerStats PlayerStats[]
  manager     Manager       @relation(fields: [managerId], references: [id])
}

model Player {
  id          String        @id @default(cuid())
  displayName String
  gamesPlayed Int
  number      Int?
  teamId      String?
  userId      String        @unique
  team        Team?         @relation(fields: [teamId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  PlayerStats PlayerStats[]
}

model Game {
  id          String        @id @default(cuid())
  created_at  DateTime      @default(now())
  game        String
  myTeam      String
  myPts       Int
  oppTeam     String
  oppPts      Int
  sets        Int
  maxSets     Int           @default(3)
  setScores   Json?
  setsWon     Json?
  isActive    Boolean       @default(false)
  currentSet  Int           @default(0) @db.SmallInt
  servingTeam ServingTeam?  @default(Home)
  userId      String
  season      String?
  notes       Json?
  user        User          @relation(fields: [userId], references: [id])
  PlayerStats PlayerStats[]

  @@index([userId])
}

model PlayerStats {
  id        String   @id
  playerId  String
  gameId    String
  teamId    String
  statType  StatType
  value     Int
  quality   String
  createdAt DateTime @default(now())
  updatedAt DateTime
  Game      Game     @relation(fields: [gameId], references: [id])
  Player    Player   @relation(fields: [playerId], references: [id])
  Team      Team     @relation(fields: [teamId], references: [id])

  @@index([gameId])
  @@index([playerId, createdAt(sort: Desc)])
  @@index([teamId])
}

enum Role {
  Manager
  Player
}

enum ServingTeam {
  Home
  Away
}

enum StatType {
  SERVE
  PASS
  SET
  ATTACK
  BLOCK
  DIG
}
